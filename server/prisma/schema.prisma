generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FilterCategory {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  options   FilterOption[]
  createdAt DateTime       @default(now())
}

model FilterOption {
  id               String         @id @default(uuid())
  label            String
  value            String
  filterCategoryId String
  filterCategory   FilterCategory @relation(fields: [filterCategoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
}

model Job {
  id                  String         @id @default(uuid())
  title               String
  company             String
  description         String         @db.Text
  location            String
  workplaceType       String
  education           String?
  requirements        String[]       @default([])
  contractType        String   @default("CLT")
  benefits            String?
  hasVA               Boolean        @default(false)
  hasVR               Boolean        @default(false)
  hasVT               Boolean        @default(false)
  hasLifeInsurance    Boolean        @default(false)
  hasMedicalInsurance Boolean        @default(false)
  hasDentalInsurance  Boolean        @default(false)
  salary              Float?
  salaryMin           Float?
  salaryMax           Float?
  applicationUrl      String?
  contactEmail        String?
  contactPhone        String?
  originalUrl         String?
  workSchedule        String?
  source              String         @default("MANUAL")
  sourceJobId         String?        @unique
  clicksCount         Int            @default(0)
  isActive            Boolean        @default(true)
  customData          Json?          @default("{}")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([workplaceType])
  @@index([education])
  @@index([contractType])
  @@index([createdAt(sort: Desc)])
}

enum ColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  LIST
}

enum ColumnSection {
  BASIC
  CONTACT
  CLASSIFICATION
  REMUNERATION
  REQUIREMENTS
  DESCRIPTION
  ADDITIONAL
}

model JobCustomColumn {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  type         ColumnType    @default(STRING)
  section      ColumnSection @default(ADDITIONAL)
  isRequired   Boolean    @default(false)
  isActive     Boolean    @default(true)
  isNative     Boolean    @default(false)
  isFilterable Boolean    @default(false)
  options      String[]   @default([])
  createdAt    DateTime   @default(now())
}
